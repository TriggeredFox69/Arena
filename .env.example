# Netlify + Supabase environment variables
# Set these in the Netlify dashboard: Site settings > Environment variables

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# JWT (must match frontend/backend expectations)
JWT_SECRET=your_secure_jwt_secret_at_least_32_chars
JWT_EXPIRE=7d

# App config
COIN_PRICE=10
FRONTEND_URL=https://your-site.netlify.app
NODE_ENV=production
